FoamFile { version 2.0; format ascii; class volScalarField; object alpha.water; }
dimensions [0 0 0 0 0];
internalField uniform 1;
boundaryField
{
    inlet        { type fixedValue; value $internalField; }
    outlet       { type inletOutlet; inletValue $internalField; value $internalField; }
    "(top|bottom)Wall" { type symmetryPlane; }
    hydrofoil    { type zeroGradient; }
    frontAndBack { type empty; }
}
